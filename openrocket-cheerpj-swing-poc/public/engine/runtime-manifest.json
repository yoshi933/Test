{
  "runtime": {
    "name": "CheerpJ",
    "version": "4.3",
    "loaderUrl": "https://cjrtnc.leaningtech.com/4.3/loader.js",
    "jre": "Java runtime via CheerpJ",
    "target": "Browser"
  },
  "application": {
    "name": "OpenRocket",
    "type": "Swing desktop research prototype",
    "status": "placeholder",
    "launchStrategy": "cheerpjRunJar / cheerpjRunMain",
    "jar": "/app/engine/openrocket-app.jar",
    "classPath": [
      "/app/engine/openrocket-app.jar"
    ],
    "notes": [
      "The OpenRocket application is distributed as a self-contained fat JAR.",
      "openrocket-core.jar is intentionally not required.",
      "This file is a scaffold placeholder and not a production runtime manifest."
    ]
  },
  "browser": {
    "httpRoot": "/app/",
    "assetPath": "/app/engine/",
    "samplePath": "/app/samples/"
  }
}
